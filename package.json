{
  "name": "ex-libris",
  "version": "0.1.3",
  "description": "Ex Libris 藏书票 — 把豆瓣书影音和番茄小说收进一个 iBooks 风格书架。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "install:plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "bookshelf",
    "douban",
    "fanqie"
  ],
  "author": "Yolkbun",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3"
  }
}
